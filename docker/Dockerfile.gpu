ARG GPU_BASE=ghcr.io/tarfersoul/clashbench@sha256:99282747965966b43f98efaf9524355e82b992b6c1e56fe85dbd3c09bf3c311c
ARG GPU_RUNTIME_IMAGE=clashbench:gpu-runtime
FROM ${GPU_RUNTIME_IMAGE} AS runtime
FROM node:22.16.0-bookworm-slim AS harnesses
ENV npm_config_fetch_retries=1 npm_config_fetch_timeout=60000 npm_config_registry=https://registry.npmjs.org/
ARG CODEX_VERSION=0.154.0
ARG CLAUDE_VERSION=2.1.272
ARG OPENCODE_VERSION=1.18.31
RUN npm install --prefix /opt/harness/codex "@openai/codex@$CODEX_VERSION" \
    && npm install --prefix /opt/harness/claude "@anthropic-ai/claude-code@$CLAUDE_VERSION" \
    && npm install --prefix /opt/harness/opencode "opencode-ai@$OPENCODE_VERSION"

FROM ${GPU_BASE}
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN rm -f /etc/apt/apt.conf.d/99pjlab-direct \
    && printf 'deb https://archive.ubuntu.com/ubuntu/ jammy main restricted universe multiverse\ndeb https://archive.ubuntu.com/ubuntu/ jammy-updates main restricted universe multiverse\ndeb https://security.ubuntu.com/ubuntu/ jammy-security main restricted universe multiverse\n' > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources \
    && apt-get -o Acquire::http::Timeout=30 -o Acquire::Retries=1 update \
    && apt-get -o Acquire::http::Timeout=30 -o Acquire::Retries=1 install -y --no-install-recommends \
       tini sudo git curl ca-certificates jq procps psmisc iproute2 net-tools lsof util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && (id agentb >/dev/null 2>&1 || useradd -m -s /bin/bash agentb)
COPY --from=harnesses /usr/local/bin/node /usr/local/bin/node
COPY --from=harnesses /opt/harness /opt/harness
# Sources and binary environments are supplied by build_gpu_context.py.
# Keep training (torch 2.6 / CUDA 12.4) separate from vLLM (torch 2.10).
COPY --from=runtime /runtime/llamafactory /opt/acb-runtime/llamafactory
COPY --from=runtime /runtime/fastpath /opt/acb-runtime/fastpath
COPY --from=runtime /runtime/vllm /opt/acb-runtime/vllm
COPY --from=runtime /runtime/manifest.json /opt/acb-runtime/manifest.json
COPY clashbench /opt/acb/acb
COPY docker/check_gpu_runtime.py /opt/acb/check_gpu_runtime.py
RUN mkdir -p /opt/node/bin \
    && ln -sfn /usr/local/bin/node /opt/node/bin/node \
    && for cli in codex claude opencode; do \
         ln -sfn /opt/acb/acb/harness.py /usr/local/bin/$cli; \
         ln -sfn /opt/acb/acb/harness.py /opt/node/bin/$cli; \
       done \
    && chmod 755 /opt/acb/acb/harness.py \
    && rm -rf /opt/llamafactory /opt/qwen35_fastpath /opt/vllm \
    && ln -sfn /opt/acb-runtime/llamafactory /opt/llamafactory \
    && ln -sfn /opt/acb-runtime/fastpath /opt/qwen35_fastpath \
    && ln -sfn /opt/acb-runtime/vllm /opt/vllm
ENV PYTHONPATH=/opt/acb:/opt/acb-runtime/fastpath:/opt/acb-runtime/llamafactory/src \
    DISABLE_VERSION_CHECK=1 \
    HOST_LF=/opt/acb-runtime/llamafactory \
    HOST_LLAMAFACTORY=/opt/acb-runtime/llamafactory \
    HOST_FAST=/opt/acb-runtime/fastpath \
    HOST_FASTPATH=/opt/acb-runtime/fastpath \
    HOST_QWEN35_FASTPATH=/opt/acb-runtime/fastpath \
    HOST_VLLM=/opt/acb-runtime/vllm
LABEL org.opencontainers.image.source="https://github.com/TarferSoul/CLASHBench"
WORKDIR /opt/acb
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/conda/bin/python", "-m", "acb.container"]
