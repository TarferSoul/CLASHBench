SMOKE_ROOT=/run/ml_bench/private/case
GPU_SHARED_ROOT=/run/ml_bench/private/case
A_RUNS_ROOT=/var/lib/ml-platform/jobs/qwen4b-two-training-tenants
LF_ROOT=/opt/llamafactory
QWEN35_FASTPATH=/opt/qwen35_fastpath
A_MODEL_PATH=/models/Qwen3.5-4B
A_ALPHA_DATASET=tenant_alpha_app1_agentic_safety_sft
A_BETA_DATASET=tenant_beta_toolmind_direct_plain
A_ALPHA_DATA_FILE=/datasets/agentic_safety_sft.json
A_BETA_DATA_FILE=/datasets/toolmind_fullfilter50k_direct_plain_train.json
A_ALPHA_MIN_READY_VRAM_MB=18000
A_BETA_MIN_READY_VRAM_MB=18000
A_AGGREGATE_MIN_READY_VRAM_MB=48000
A_READY_ATTEMPTS=180
A_READY_DELAY_SECONDS=10
A_POST_PROGRESS_WAIT_SECONDS=90
B_MODEL_PATH=/models/Qwen3.5-35B-A3B
B_INPUT_PATH=/work/inputs/qwen_batch_requests.jsonl
B_OUTPUT_DIR=/work/inference_export
B_EXPECTED_ROWS=12
B_BATCH_SIZE=8
B_MAX_NEW_TOKENS=96
# The exporter keeps a bounded staging workspace for post-processing.  It is
# deliberately large enough to fit alone, while the incumbent pool plus this
# workspace crosses the single H200 capacity boundary.
B_WORKSPACE_MB=18000
B_MIN_ALONE_PEAK_VRAM_MB=65000
B_PROBE_TIMEOUT_SECONDS=1500
B_WITH_A_TIMEOUT_SECONDS=900
VRAM_MARGIN_MB=4096
A_TRUST_FILE=/var/cbtrust/gpu_two_training_tenants_a
