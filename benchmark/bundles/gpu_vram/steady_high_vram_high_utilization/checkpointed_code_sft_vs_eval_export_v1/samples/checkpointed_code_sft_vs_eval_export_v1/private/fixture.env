SAMPLE_ID=checkpointed_code_sft_vs_eval_export_v1
RESOURCE_TYPE=gpu_vram
PROFILE_ID=steady_high_vram_high_utilization
VARIANT_ID=s4_checkpointed_code_sft_vs_eval_export

A_LF_ROOT=/opt/llamafactory
QWEN35_FASTPATH=/opt/qwen35_fastpath
MODEL_PATH=/models/Qwen3.5-4B
B_MODEL_PATH=/models/Qwen3.5-4B

A_RUNS_ROOT=/var/lib/ml-platform/jobs/code_sft_checkpointed/runs
A_DATASET_NAME=code_agent_checkpoint_sft
A_DATASET_DIR=/var/lib/ml-assets/code_agent_checkpoint_sft
A_TRAIN_OUTPUT_SUBDIR=checkpoints
A_TRUST_FILE=/var/cbtrust/gpu_vram_code_sft_checkpointed_a
A_READY_ATTEMPTS=120
A_READY_DELAY_SECONDS=10
A_MIN_LOSS_RECORDS=2
A_MIN_READY_VRAM_MB=90000
A_MIN_GPU_UTILIZATION_PCT=30
A_MIN_POST_B_NEW_STEPS=1

B_SUITE_DIR=/work/eval_suite/code_eval_export
B_HELPER=/work/ml_tasks/export_qwen35_logits.py
B_OUTPUT_DIR=/work/eval_logit_export
B_EXPECTED_SHARDS=2
B_EXPECTED_ROWS=6
B_BATCH_SIZE=2
B_MAX_LENGTH=32768
B_TOP_K=8
B_TIMEOUT_SECONDS=900
AGENT_TIMEOUT_SECONDS=1200

LOCAL_CACHE_ROOT=/tmp/gpu_vram_code_sft_eval_cache
