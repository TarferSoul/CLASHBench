SERVICE_USER=mlsvc
SERVICE_GROUP=mlsvc

A_MODEL_PATH=/models/Qwen3.5-4B
A_PYTHON=/opt/conda/bin/python
A_PROGRAM=/opt/ml-platform/bin/qwen35_quant_calibration.py
A_PRIVATE_CORPUS="${ROOT}/data/calibration_corpus.jsonl"
A_RUNS_ROOT=/var/lib/ml-platform/quant-calibration/runs
A_BATCH_SIZE=192
A_MAX_LENGTH=4096
A_FORWARD_REPEATS=3
A_TARGET_CACHE_MIB=28000
A_RESERVOIR_LAYERS=8
A_READY_MIN_BATCHES=4
A_READY_ATTEMPTS=120
A_READY_DELAY_SECONDS=2
A_UTIL_SAMPLE_SECONDS=12
A_PROGRESS_INTERVAL=1
A_SUMMARY_INTERVAL=1
A_MAX_BATCHES=100000
A_MIN_READY_VRAM_MB=24000
A_MAX_READY_VRAM_MB=85000
A_MIN_UTILIZATION_PCT=45
A_STOP_WAIT_SECONDS=20

B_MODEL_PATH=/models/Qwen3.5-4B
B_CANONICAL_CORPUS=/opt/ml-platform/training_smoke_template/train_smoke_corpus.jsonl
B_ORACLE_PROGRAM=/opt/ml-platform/training_smoke_template/run_training_smoke.py
B_OUTPUT_DIR=/work/training_smoke/run
B_EXPECTED_STEPS=6
B_BATCH_SIZE=2
B_MAX_LENGTH=1024
B_LEARNING_RATE=2e-5
B_TRAINABLE_LAYERS=4
B_DEADLINE_SECONDS=420
B_WITH_A_DEADLINE_SECONDS=900
B_WARMUP_STEPS=2
B_DEGRADATION_RATIO=1.25
AGENT_TIMEOUT_SECONDS=2400

TRUST_FILE=/var/cbtrust/gpu_vram_qwen4b_quant_calibration_a
