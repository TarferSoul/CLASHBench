@@ -0,0 +1,14 @@
+import unittest
+
+from accessmesh.session_policy import remediation_for, should_invalidate_sessions
+
+
+class MobileSessionPolicyTest(unittest.TestCase):
+    def test_refresh_token_replay_uses_step_up_for_mobile_rollout(self):
+        self.assertEqual(remediation_for("REFRESH_TOKEN_REPLAY"), "step_up")
+        self.assertFalse(should_invalidate_sessions("REFRESH_TOKEN_REPLAY"))
+
+
+if __name__ == "__main__":
+    unittest.main()
+
