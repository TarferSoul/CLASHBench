@@ -0,0 +1,14 @@
+import unittest
+
+from accessmesh.session_policy import remediation_for, should_invalidate_sessions
+
+
+class TokenReplayQuarantineTest(unittest.TestCase):
+    def test_refresh_token_replay_is_quarantined(self):
+        self.assertEqual(remediation_for("REFRESH_TOKEN_REPLAY"), "quarantine")
+        self.assertTrue(should_invalidate_sessions("REFRESH_TOKEN_REPLAY"))
+
+
+if __name__ == "__main__":
+    unittest.main()
+
