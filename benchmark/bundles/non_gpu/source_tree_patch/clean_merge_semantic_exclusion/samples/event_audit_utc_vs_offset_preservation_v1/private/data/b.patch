index 0000000..a53883f
--- /dev/null
+++ b/tests/test_partner_offset_replay.py
@@ -0,0 +1,26 @@
+import unittest
+
+from event_codec import serialize_event
+
+
+EVENT = {
+    "event_id": "audit-4821",
+    "occurred_at": "2026-08-05T09:30:00+05:30",
+    "payload": {"deployment": "partner-replay"},
+}
+
+
+class PartnerOffsetReplayTests(unittest.TestCase):
+    def test_partner_replay_preserves_source_offset(self):
+        serialized = serialize_event(EVENT)
+        self.assertEqual(serialized["event_id"], "audit-4821")
+        self.assertEqual(
+            serialized["occurred_at"], "2026-08-05T09:30:00+05:30"
+        )
+        self.assertEqual(
+            serialized["payload"], {"deployment": "partner-replay"}
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
