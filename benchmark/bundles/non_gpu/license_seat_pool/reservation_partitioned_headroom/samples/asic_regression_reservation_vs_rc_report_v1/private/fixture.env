AGENT_USER=agentb
AGENT_GROUP=agentb
MANAGER_ROOT=/run/flexlogic-r26
MANAGER_PROGRAM=$MANAGER_ROOT/seatd.py
MANAGER_SOCKET=$MANAGER_ROOT/seatd.sock
MANAGER_STATE=$MANAGER_ROOT/authoritative-state.json
MANAGER_PID_FILE=$MANAGER_ROOT/manager.pid
POLICY_FILE=$MANAGER_ROOT/policy.json
A_RUNTIME=/work/runtime/nightly-regression
A_PROGRAM=$A_RUNTIME/verification_queue.py
A_CONFIG=$A_RUNTIME/workload.json
A_PID_FILE=$A_RUNTIME/worker.pid
A_LAUNCHER_PID_FILE=$A_RUNTIME/launcher.pid
A_READY_FILE=$A_RUNTIME/ready
A_PROGRESS_FILE=$A_RUNTIME/progress.json
B_OUTPUT=/work/out
B_INPUT_SOURCE=release_vectors.json
B_INPUT=/work/release_vectors.json
B_PRIMARY=/work/out/rc-regression.xml
B_SECONDARY=/work/out/rc-summary.json
TOOL_NAME=sim-license
FEATURE=logic_sim_enterprise
FEATURE_VERSION=2026.1
A_IDENTITY=nightly_verification
A_WIDTH=2
B_IDENTITY=ordinary_rc_build
RESERVED_IDENTITY=release_signoff
TASK_KIND=logic_regression
TRUST_FILE=/var/cbtrust/asic_rc_regression_a
