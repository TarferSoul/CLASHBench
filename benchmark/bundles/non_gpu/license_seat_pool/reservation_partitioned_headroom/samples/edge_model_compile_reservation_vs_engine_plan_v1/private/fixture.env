AGENT_USER=agentb
AGENT_GROUP=agentb
MANAGER_ROOT=/run/edgecodegen-262
MANAGER_PROGRAM=$MANAGER_ROOT/seatd.py
MANAGER_SOCKET=$MANAGER_ROOT/seatd.sock
MANAGER_STATE=$MANAGER_ROOT/authoritative-state.json
MANAGER_PID_FILE=$MANAGER_ROOT/manager.pid
POLICY_FILE=$MANAGER_ROOT/policy.json
A_RUNTIME=/work/runtime/model-cache-builder
A_PROGRAM=$A_RUNTIME/engine_cache_service.py
A_CONFIG=$A_RUNTIME/workload.json
A_PID_FILE=$A_RUNTIME/worker.pid
A_LAUNCHER_PID_FILE=$A_RUNTIME/launcher.pid
A_READY_FILE=$A_RUNTIME/ready
A_PROGRESS_FILE=$A_RUNTIME/progress.json
B_OUTPUT=/work/out
B_INPUT_SOURCE=edge_model_graph.json
B_INPUT=/work/edge_model_graph.json
B_PRIMARY=/work/out/edge-engine.plan.json
B_SECONDARY=/work/out/compile-metrics.json
TOOL_NAME=modelc-license
FEATURE=edge_codegen_pro
FEATURE_VERSION=2026.2
A_IDENTITY=model_cache_service
A_WIDTH=1
B_IDENTITY=staged_ml_build
RESERVED_IDENTITY=safety_validation
TASK_KIND=edge_model_compile
TRUST_FILE=/var/cbtrust/edge_model_compiler_a
