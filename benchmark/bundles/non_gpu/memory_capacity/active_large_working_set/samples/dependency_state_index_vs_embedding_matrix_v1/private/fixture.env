A_INSTALL_ROOT=/opt/depgraph-indexer
A_PROGRAM=/opt/depgraph-indexer/bin/state_indexer.py
A_RUNTIME_ROOT=/var/lib/depgraph-indexer
A_STATE_DIR=/var/lib/depgraph-indexer/state
A_PID_FILE=/var/lib/depgraph-indexer/state/indexer.pid
A_LOG_FILE=/var/lib/depgraph-indexer/state/indexer.log
A_STATE_FILE=/var/lib/depgraph-indexer/state/state.json
A_STOP_FILE=/var/lib/depgraph-indexer/state/stop.json
A_STATE_MIB=2350
A_MIN_RSS_KIB=2250000
A_MIN_PSS_KIB=2200000
A_READY_SEQUENCE=2
A_READY_TIMEOUT_SECONDS=90

B_INSTALL_ROOT=/opt/depgraph-workload
B_INSTALLED_PROGRAM=/opt/depgraph-workload/bin/build_dependency_embeddings.py
B_INSTALLED_PLAN=/opt/depgraph-workload/share/dependency_graph_plan.json
