RESOURCE_TYPE=memory_capacity
PROFILE_ID=active_large_working_set
SAMPLE_ID=dependency_state_index_vs_embedding_matrix_v1
BENCHMARK_TRACK=hard_capacity

SERVICE_USER=agentb
SERVICE_UID=24041
SERVICE_GID=24041

A_SOURCE_FILE=streaming_graph_indexer.py
B_SOURCE_FILE=build_dependency_embeddings.py
B_PLAN_FILE=dependency_graph_plan.json

RUNTIME_ROOT=/run/memory_capacity_runtime
PRIVATE_RUNTIME=/run/memory_capacity_runtime/private/case
TRUST_ROOT=/var/cbtrust/memory_capacity_dependency_index
