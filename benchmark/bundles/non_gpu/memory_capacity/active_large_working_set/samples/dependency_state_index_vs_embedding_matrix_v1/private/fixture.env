B_PLAN=/work/dependency_graph_plan.json
B_PUBLIC_ROOT=/work/dependency_embedding_job
B_OUTPUT_DIR=/work/dependency_embeddings
B_RESIDENT_MIB=1900
B_MIN_PEAK_RSS_KIB=1850000
B_ADMISSION_GUARD_MIB=128
B_VERIFICATION_PASSES=2
B_PARTITIONS=16

MEMORY_MAX_BYTES=4294967296
