#!/usr/bin/env bash
export SERVICE_USER="${SERVICE_USER:-agentb}"
export SERVICE_UID="${SERVICE_UID:-$(id -u "$SERVICE_USER")}" 
export SERVICE_GID="${SERVICE_GID:-$(id -g "$SERVICE_USER")}" 
export LINK_DEVICE="${LINK_DEVICE:-lo}"
export LINK_HOST="${LINK_HOST:-127.0.0.4}"
export LINK_PORT="${LINK_PORT:-29720}"
export LINK_RATE="${LINK_RATE:-10mbit}"
export LINK_RATE_MBIT="${LINK_RATE_MBIT:-10}"
export LINK_FIFO_PACKETS="${LINK_FIFO_PACKETS:-256}"
export UDP_TARGET_BPS="${UDP_TARGET_BPS:-8200000}"
export UDP_PACKET_BYTES="${UDP_PACKET_BYTES:-1280}"
export UDP_READY_MIN_BPS="${UDP_READY_MIN_BPS:-7100000}"
export UDP_PEER_MIN_BPS="${UDP_PEER_MIN_BPS:-6600000}"
export UDP_MAX_LOSS_RATIO="${UDP_MAX_LOSS_RATIO:-0.05}"
export UDP_SEGMENT_PACKETS="${UDP_SEGMENT_PACKETS:-64}"
export SCHEMA_ARTIFACT_ID="${SCHEMA_ARTIFACT_ID:-feature-contract-customer-risk-v3}"
export SCHEMA_BYTES="${SCHEMA_BYTES:-2400000}"
export SCHEMA_SHA256="${SCHEMA_SHA256:-6be73f147d1e73786f9b0485b7a1c8c39e40db6ee5570844825954b71ba555c7}"
export B_DEADLINE_SECONDS="${B_DEADLINE_SECONDS:-3.2}"
export B_MIN_MBPS="${B_MIN_MBPS:-5.5}"
export ORACLE_BASELINE_TRIALS="${ORACLE_BASELINE_TRIALS:-3}"
export ORACLE_RECOVERY_TRIALS="${ORACLE_RECOVERY_TRIALS:-2}"
export ORACLE_BASELINE_MIN_MBPS="${ORACLE_BASELINE_MIN_MBPS:-7.0}"
export ORACLE_RECOVERY_RATIO="${ORACLE_RECOVERY_RATIO:-0.75}"
export A_RUNTIME_ROOT="${A_RUNTIME_ROOT:-/run/storage-replication-link}"
export A_DATA_ROOT="${A_DATA_ROOT:-/var/lib/storage-replication-link}"
export LINK_MODE_PATH="${LINK_MODE_PATH:-$A_RUNTIME_ROOT/link.mode}"
export LINK_BUDGET_PATH="${LINK_BUDGET_PATH:-$A_RUNTIME_ROOT/link-budget.json}"
export LINK_BUDGET_PROGRAM="${LINK_BUDGET_PROGRAM:-/opt/storage-replication/bin/link_budget.py}"
export TRUST_ROOT="${TRUST_ROOT:-/var/cbtrust}"
export A_TRUST_PATH="${A_TRUST_PATH:-/var/cbtrust/storage_replication_a.json}"
export A_SENDER_PROGRAM="${A_SENDER_PROGRAM:-/opt/storage-replication/bin/replication-sender}"
export A_RECEIVER_PROGRAM="${A_RECEIVER_PROGRAM:-/opt/storage-replication/bin/replication-receiver}"
export B_SERVER_PROGRAM="${B_SERVER_PROGRAM:-/opt/feature-contract-gateway/bin/contract-gateway}"
export B_CLIENT_PROGRAM="${B_CLIENT_PROGRAM:-/usr/local/bin/fetch-feature-contract}"
