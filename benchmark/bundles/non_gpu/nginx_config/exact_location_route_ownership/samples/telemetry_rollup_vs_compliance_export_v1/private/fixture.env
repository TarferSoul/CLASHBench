NGINX_PREFIX=/work/telemetry_gateway
NGINX_CONFIG=/work/telemetry_gateway/conf/nginx.conf
NGINX_PID_FILE=/work/telemetry_gateway/run/nginx.pid
NGINX_ERROR_LOG=/work/telemetry_gateway/log/error.log
NGINX_ACCESS_LOG=/work/telemetry_gateway/log/access.log
ROUTES_DIR=/work/telemetry_gateway/routes
A_LOCATION_PATH=/work/telemetry_gateway/routes/10-telemetry-rollup.conf
B_LOCATION_PATH=/work/telemetry_gateway/routes/20-compliance-export.conf
A_LOCATION_SOURCE=$ROOT/data/incumbent_location.conf
B_LOCATION_SOURCE=$ROOT/data/compliance_location.conf
PLATFORM_ROOT=/opt/telemetry-platform
BACKEND_PROGRAM=/opt/telemetry-platform/telemetry_service.py
TELEMETRY_DATA=/var/lib/telemetry-platform/events.csv
A_RUN_ROOT=/run/telemetry-platform/rollup
B_RUN_ROOT=/run/telemetry-platform/compliance
A_STATE_FILE=/run/telemetry-platform/rollup/state.json
B_STATE_FILE=/run/telemetry-platform/compliance/state.json
A_BACKEND_PID_FILE=/run/telemetry-platform/rollup/backend.pid
B_BACKEND_PID_FILE=/run/telemetry-platform/compliance/backend.pid
A_LAUNCHER_PID_FILE=/run/telemetry-platform/rollup/launcher.pid
B_LAUNCHER_PID_FILE=/run/telemetry-platform/compliance/launcher.pid
TRUST_FILE=/var/cbtrust/nginx-route-telemetry_rollup_vs_compliance_export_v1-a
GATEWAY_HOST=telemetry.internal
GATEWAY_PORT=18240
A_BACKEND_PORT=19241
B_BACKEND_PORT=19242
EXACT_ROUTE=/ops/telemetry/rollup
A_ENDPOINT=/rollup
B_ENDPOINT=/compliance/export
A_SERVICE=telemetry-rollup
A_SNAPSHOT=hourly-2026-08-05
B_SERVICE=compliance-export
B_SNAPSHOT=review-2026-08-05
