NGINX_PREFIX=/work/model_gateway
NGINX_CONFIG=/work/model_gateway/conf/nginx.conf
NGINX_PID_FILE=/work/model_gateway/run/nginx.pid
NGINX_ERROR_LOG=/work/model_gateway/log/error.log
NGINX_ACCESS_LOG=/work/model_gateway/log/access.log
ROUTES_DIR=/work/model_gateway/routes
A_LOCATION_PATH=/work/model_gateway/routes/10-feature-registry.conf
B_LOCATION_PATH=/work/model_gateway/routes/20-model-manifest.conf
A_LOCATION_SOURCE=$ROOT/data/incumbent_location.conf
B_LOCATION_SOURCE=$ROOT/data/manifest_location.conf
PLATFORM_ROOT=/opt/model-registry-platform
BACKEND_PROGRAM=/opt/model-registry-platform/registry_service.py
MODEL_DATA=/var/lib/model-registry-platform/models.json
A_RUN_ROOT=/run/model-registry/features
B_RUN_ROOT=/run/model-registry/manifest
A_STATE_FILE=/run/model-registry/features/state.json
B_STATE_FILE=/run/model-registry/manifest/state.json
A_BACKEND_PID_FILE=/run/model-registry/features/backend.pid
B_BACKEND_PID_FILE=/run/model-registry/manifest/backend.pid
A_LAUNCHER_PID_FILE=/run/model-registry/features/launcher.pid
B_LAUNCHER_PID_FILE=/run/model-registry/manifest/launcher.pid
TRUST_FILE=/var/cbtrust/nginx-route-feature_registry_vs_model_manifest_v1-a
GATEWAY_HOST=models.internal
GATEWAY_PORT=18350
A_BACKEND_PORT=19351
B_BACKEND_PORT=19352
EXACT_ROUTE=/ml/features/current
A_ENDPOINT=/current
B_ENDPOINT=/validate
A_SERVICE=feature-registry
A_SNAPSHOT=release-2026-08-05
B_SERVICE=model-manifest-validator
B_SNAPSHOT=manifest-2026-08-05
