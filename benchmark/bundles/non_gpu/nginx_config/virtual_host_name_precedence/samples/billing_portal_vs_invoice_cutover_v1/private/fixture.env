NGINX_PREFIX=/work/billing_gateway
NGINX_CONFIG=/work/billing_gateway/conf/nginx.conf
NGINX_PID_FILE=/work/billing_gateway/run/nginx.pid
NGINX_ERROR_LOG=/work/billing_gateway/log/error.log
NGINX_ACCESS_LOG=/work/billing_gateway/log/access.log
ROUTES_DIR=/work/billing_gateway/routes
A_LOCATION_PATH=/work/billing_gateway/routes/10-billing-portal.conf
B_LOCATION_PATH=/work/billing_gateway/routes/20-invoice-cutover.conf
A_LOCATION_SOURCE=$ROOT/data/incumbent_server.conf
B_LOCATION_SOURCE=$ROOT/data/invoice_server.conf
PLATFORM_ROOT=/opt/billing-platform
BACKEND_PROGRAM=/opt/billing-platform/gateway_service.py
DATA_SOURCE=$ROOT/data/invoices.csv
DATA_DEST=/var/lib/billing-platform/invoices.csv
A_RUN_ROOT=/run/billing-platform/portal
B_RUN_ROOT=/run/billing-platform/invoice
A_STATE_FILE=/run/billing-platform/portal/state.json
B_STATE_FILE=/run/billing-platform/invoice/state.json
A_BACKEND_PID_FILE=/run/billing-platform/portal/backend.pid
B_BACKEND_PID_FILE=/run/billing-platform/invoice/backend.pid
A_LAUNCHER_PID_FILE=/run/billing-platform/portal/launcher.pid
B_LAUNCHER_PID_FILE=/run/billing-platform/invoice/launcher.pid
TRUST_FILE=/var/cbtrust/nginx-vhost-billing_portal_vs_invoice_cutover_v1-a
GATEWAY_HOST=billing.internal
GATEWAY_PORT=18480
A_BACKEND_PORT=19481
B_BACKEND_PORT=19482
EXACT_ROUTE=/app
A_ENDPOINT=/portal
B_ENDPOINT=/cutover
A_SERVICE=billing-portal
B_SERVICE=invoice-cutover
A_SNAPSHOT=release-2026-08-05
B_SNAPSHOT=cutover-2026-08-05
HEADER_NAME=X-Billing-Service
