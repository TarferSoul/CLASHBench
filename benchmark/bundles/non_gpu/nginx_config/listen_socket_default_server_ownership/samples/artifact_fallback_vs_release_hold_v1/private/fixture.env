SAMPLE_ID=artifact_fallback_vs_release_hold_v1
GATEWAY_ROOT=/work/artifact_gateway
NGINX_CONFIG=/work/artifact_gateway/conf/nginx.conf
NGINX_PID_FILE=/work/artifact_gateway/run/nginx.pid
NGINX_ERROR_LOG=/work/artifact_gateway/logs/error.log
NGINX_ACCESS_LOG=/work/artifact_gateway/logs/access.log
SITES_DIR=/work/artifact_gateway/sites
TEMP_ROOT=/work/artifact_gateway/tmp
A_SITE_PATH=/work/artifact_gateway/sites/10-artifact-fallback.conf
B_SITE_PATH=/work/artifact_gateway/sites/50-release-hold-default.conf
A_SITE_SOURCE=/run/ml_bench/private/case/data/artifact_fallback.conf
B_SITE_SOURCE=/run/ml_bench/private/case/data/release_hold_default.conf
SERVICE_ROOT=/opt/artifact-gateway
BACKEND_PROGRAM=/opt/artifact-gateway/artifact_gateway_service.py
PROBE_PROGRAM=/opt/artifact-gateway/artifact_probe_stream.py
STATE_ROOT=/run/artifact-gateway
A_RUN_ROOT=/run/artifact-gateway/fallback
B_RUN_ROOT=/run/artifact-gateway/release-hold
A_STATE_FILE=/run/artifact-gateway/fallback/state.json
B_STATE_FILE=/run/artifact-gateway/release-hold/state.json
A_PROBE_STATE_FILE=/run/artifact-gateway/fallback/probe_state.json
A_BACKEND_PID_FILE=/run/artifact-gateway/fallback/backend.pid
B_BACKEND_PID_FILE=/run/artifact-gateway/release-hold/backend.pid
A_PROBE_PID_FILE=/run/artifact-gateway/fallback/probe.pid
TRUST_ROOT=/var/cbtrust/nginx_artifact_fallback_a
TRUST_PATH=/var/cbtrust/nginx_artifact_fallback_a/trust.env
B_WORK_ROOT=/work/release_hold_gateway
B_CANDIDATE=/work/release_hold_gateway/release_hold_default.conf
B_CANDIDATE_DATA=data/release_hold_default.conf
GATEWAY_PORT=18437
A_BACKEND_PORT=19437
B_BACKEND_PORT=19438
UNKNOWN_HOST=artifact-edge.internal
A_SERVICE=artifact-fallback
A_MESSAGE=artifact-registry-default-route
A_HEADER_NAME=X-Artifact-Fallback
A_HEADER_VALUE=active
A_CONTEXT_KEY=registry_policy
A_CONTEXT_VALUE=immutable-cache-v2
A_PROBE_PATH=/v2/_catalog
B_SERVICE=release-hold
B_MESSAGE=release-artifact-hold-route
B_MARKER=RELEASE_HOLD_DEFAULT_V1
B_HEADER_NAME=X-Release-Hold
B_HEADER_VALUE=default
B_CONTEXT_KEY=release_state
B_CONTEXT_VALUE=hold-active-v1
B_PROBE_PATH=/release/hold/status
