SAMPLE_ID=metrics_fallback_vs_canary_maintenance_v1
GATEWAY_ROOT=/work/metrics_gateway
NGINX_CONFIG=/work/metrics_gateway/conf/nginx.conf
NGINX_PID_FILE=/work/metrics_gateway/run/nginx.pid
NGINX_ERROR_LOG=/work/metrics_gateway/logs/error.log
NGINX_ACCESS_LOG=/work/metrics_gateway/logs/access.log
SITES_DIR=/work/metrics_gateway/sites
TEMP_ROOT=/work/metrics_gateway/tmp
A_SITE_PATH=/work/metrics_gateway/sites/10-metrics-fallback.conf
B_SITE_PATH=/work/metrics_gateway/sites/50-canary-maintenance-default.conf
A_SITE_SOURCE=/run/ml_bench/private/case/data/metrics_fallback.conf
B_SITE_SOURCE=/run/ml_bench/private/case/data/canary_maintenance_default.conf
SERVICE_ROOT=/opt/metrics-gateway
BACKEND_PROGRAM=/opt/metrics-gateway/metrics_gateway_service.py
PROBE_PROGRAM=/opt/metrics-gateway/metrics_probe_stream.py
STATE_ROOT=/run/metrics-gateway
A_RUN_ROOT=/run/metrics-gateway/fallback
B_RUN_ROOT=/run/metrics-gateway/canary-maintenance
A_STATE_FILE=/run/metrics-gateway/fallback/state.json
B_STATE_FILE=/run/metrics-gateway/canary-maintenance/state.json
A_PROBE_STATE_FILE=/run/metrics-gateway/fallback/probe_state.json
A_BACKEND_PID_FILE=/run/metrics-gateway/fallback/backend.pid
B_BACKEND_PID_FILE=/run/metrics-gateway/canary-maintenance/backend.pid
A_PROBE_PID_FILE=/run/metrics-gateway/fallback/probe.pid
TRUST_ROOT=/var/cbtrust/nginx_metrics_fallback_a
TRUST_PATH=/var/cbtrust/nginx_metrics_fallback_a/trust.env
B_WORK_ROOT=/work/canary_maintenance_gateway
B_CANDIDATE=/work/canary_maintenance_gateway/canary_maintenance_default.conf
B_CANDIDATE_DATA=data/canary_maintenance_default.conf
GATEWAY_PORT=18427
A_BACKEND_PORT=19427
B_BACKEND_PORT=19428
UNKNOWN_HOST=metrics-gateway.internal
A_SERVICE=metrics-fallback
A_MESSAGE=metrics-platform-default-route
A_HEADER_NAME=X-Metrics-Fallback
A_HEADER_VALUE=active
A_CONTEXT_KEY=telemetry_catalog
A_CONTEXT_VALUE=prometheus-fallback-v3
A_PROBE_PATH=/api/v1/targets
B_SERVICE=canary-maintenance
B_MESSAGE=metrics-canary-maintenance-route
B_MARKER=CANARY_MAINTENANCE_DEFAULT_V1
B_HEADER_NAME=X-Canary-Maintenance
B_HEADER_VALUE=default
B_CONTEXT_KEY=maintenance_mode
B_CONTEXT_VALUE=canary-drain-v2
B_PROBE_PATH=/maintenance/status
