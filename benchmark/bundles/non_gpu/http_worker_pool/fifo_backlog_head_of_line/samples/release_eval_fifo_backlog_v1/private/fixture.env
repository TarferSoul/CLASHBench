A_MIN_COMPLETED_READY=1
A_SERVICE_SECONDS=0.85
A_READY_ATTEMPTS=120
A_READY_DELAY_SECONDS=0.1

B_SERVICE_SECONDS=0.25
B_BASELINE_RUNS=3
B_DEADLINE_SECONDS=2.0
B_CLIENT_TIMEOUT_SECONDS=2.0
