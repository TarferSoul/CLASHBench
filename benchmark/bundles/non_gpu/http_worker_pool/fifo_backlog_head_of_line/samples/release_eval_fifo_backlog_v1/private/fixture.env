EVAL_REPORT_ENDPOINT=http://${SERVICE_HOST}:${SERVICE_PORT}/v1/reports/eval-card
EVAL_REPORT_WORKERS=3
EVAL_REPORT_QUEUE_CAPACITY=24
EVAL_REPORT_MAX_WAIT_SECONDS=90

A_TOTAL_REQUESTS=24
