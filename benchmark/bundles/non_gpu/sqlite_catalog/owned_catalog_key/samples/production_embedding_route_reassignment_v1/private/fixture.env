CATALOG_DIR=/var/lib/inference_catalog
CATALOG_DB=/var/lib/inference_catalog/catalog.sqlite
CLI_NAME=catalogctl
CLI_SOURCE=catalogctl.py

A_RUNTIME_DIR=/opt/inference-route-service
A_RUNTIME_PROGRAM=/opt/inference-route-service/route_gateway.py
A_RUN_DIR=/run/inference-route-service
A_PID_FILE=/run/inference-route-service/holder.pid
A_LAUNCHER_FILE=/run/inference-route-service/launcher.pid
A_HEARTBEAT_FILE=/run/inference-route-service/heartbeat.json
A_LOG_FILE=/var/log/inference-route-service/gateway.log
A_TRUST_FILE=/var/cbtrust/sqlite_catalog_owned_route.json
A_REQUEST_FILE=/var/lib/inference_catalog/requests/embed_batch.json
A_HEALTH_FILE=/var/lib/inference_catalog/models/embedder-prod-v1-health.json

ROUTE_KEY=embedding.production.default
A_TARGET=embedder-prod-v1
A_REVISION=2026.07.18
A_RUNTIME=onnxruntime
A_MIN_CHECKPOINTS=3

B_TARGET=embedder-prod-v2
B_REVISION=2026.08.04
B_RUNTIME=onnxruntime
B_REPORT=/work/route_reassignment_report.json
