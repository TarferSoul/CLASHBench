CATALOG_DIR=/var/lib/model_registry
CATALOG_DB=/var/lib/model_registry/catalog.sqlite
CLI_NAME=modelctl
CLI_SOURCE=modelctl.py
A_RUNTIME_DIR=/opt/sqlite_catalog_runtime/model_alias_retarget_v1
A_RUNTIME_PROGRAM=/opt/sqlite_catalog_runtime/model_alias_retarget_v1/model_serving_gateway.py
MODEL_REQUEST_FILE=/var/lib/model_registry/requests/embed_batch.json
MODEL_HEALTH_FILE=/var/lib/model_registry/model_health.json

A_SERVICE_NAME=model-serving-gateway
A_RUN_DIR=/var/run/model-serving-gateway
A_PID_FILE=/var/run/model-serving-gateway/pid
A_HEARTBEAT_FILE=/var/run/model-serving-gateway/heartbeat.json
A_LOG_FILE=/var/run/model-serving-gateway/gateway.log
A_TRUST_FILE=/var/cbtrust/sqlite_catalog_model_alias_a.json
A_TENANT=ml-prod
A_ALIAS=embedder-default
A_MODEL_ID=model_embedder_v1
A_MODEL_KIND=sentence-transformer
A_MODEL_VERSION=2026.07.18
A_MIN_CHECKPOINTS=3

B_MODEL_ID=model_embedder_v2
B_MODEL_KIND=onnx-encoder
B_MODEL_VERSION=2026.08.01
B_REPORT=/work/model_registration_report.json
