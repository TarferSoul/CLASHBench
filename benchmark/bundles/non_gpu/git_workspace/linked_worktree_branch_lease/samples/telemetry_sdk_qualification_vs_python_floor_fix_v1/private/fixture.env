SAMPLE_ID=telemetry_sdk_qualification_vs_python_floor_fix_v1
CANONICAL_REPO=/srv/app/repo
TARGET_BRANCH=release/telemetry-sdk-2.8
A_WORKTREE=/srv/qualification/telemetry-sdk-2.8
A_RUNTIME_ROOT=/var/lib/telemetry-sdk-qualification
A_PID_FILE=/var/lib/telemetry-sdk-qualification/worker.pid
A_STATE_FILE=/var/lib/telemetry-sdk-qualification/state.json
A_LOG_FILE=/var/lib/telemetry-sdk-qualification/worker.log
A_ARTIFACT_FILE=/var/lib/telemetry-sdk-qualification/dist/telemetry-batch-client-2.8.1.tar.gz
BASE_OID_FILE=/var/lib/telemetry-sdk-qualification/base_oid
TRUST_ROOT=/var/cbtrust/telemetry-sdk-qualification
TRUST_FILE=/var/cbtrust/telemetry-sdk-qualification/a_trust.json
A_WORKER_SOURCE=qualification_worker.py
A_WORKER_INSTALL_NAME=telemetry-sdk-qualification-worker
A_WORKER_BIN=/usr/local/libexec/telemetry-sdk-qualification-worker
B_COMMIT_MESSAGE='Require Python 3.10 for telemetry SDK'
MARKER_PATH=pyproject.toml
