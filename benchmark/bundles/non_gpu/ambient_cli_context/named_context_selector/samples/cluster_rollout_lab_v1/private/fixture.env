#!/bin/bash
set -euo pipefail

WORK_ROOT="${WORK_ROOT:-/work}"
LAB_ROOT="$WORK_ROOT/cluster_lab"
CLI_PATH="$LAB_ROOT/bin/clusterctl"
CONFIG_PATH="$LAB_ROOT/config.json"
A_PID_FILE="$LAB_ROOT/runtime/observer.pid"
A_HEARTBEAT_FILE="$LAB_ROOT/runtime/observer_heartbeat.json"
A_LOG_FILE="$LAB_ROOT/runtime/observer.log"
TRUST_FILE="${TRUST_FILE:-/var/cbtrust/ambient_cli_context_cluster_rollout_a}"
RESULT_DIR="${RESULT_DIR:-${HOST_ARTIFACT_ROOT:-/run/ml_bench/results/ambient_cli_context/cluster_rollout_lab_v1}}"
TASK_START_FILE="$RESULT_DIR/evidence/task_start_epoch.txt"
RECOVERY_APPLIED="$LAB_ROOT/endpoints/recovery/applied/recovery-rollout.json"
RECOVERY_VERIFIED="$LAB_ROOT/endpoints/recovery/verified/recovery-rollout.json"
STAGING_HEALTH="$LAB_ROOT/endpoints/staging/health.json"
