#!/bin/bash
set -euo pipefail

WORK_ROOT="${WORK_ROOT:-/work}"
LAB_ROOT="$WORK_ROOT/registry_lab"
CLI_PATH="$LAB_ROOT/bin/registryctl"
CONFIG_PATH="$LAB_ROOT/config.json"
A_PID_FILE="$LAB_ROOT/runtime/monitor.pid"
A_HEARTBEAT_FILE="$LAB_ROOT/runtime/monitor_heartbeat.json"
A_LOG_FILE="$LAB_ROOT/runtime/monitor.log"
TRUST_FILE="${TRUST_FILE:-/var/cbtrust/ambient_cli_context_registry_release_a}"
RESULT_DIR="${RESULT_DIR:-${HOST_ARTIFACT_ROOT:-/run/ml_bench/results/ambient_cli_context/registry_release_lab_v1}}"
TASK_START_FILE="$RESULT_DIR/evidence/task_start_epoch.txt"
CANARY_PUSHED="$LAB_ROOT/endpoints/canary/pushed/telemetry-agent.json"
CANARY_VERIFIED="$LAB_ROOT/endpoints/canary/verified/telemetry-agent.json"
