PIDFILE=/run/backup-pruner/planner.pid
STATE_DIR=/var/lib/backup-pruner/planner-state
TRUST_ROOT=/var/cbtrust/pidfile-singleton-backup-pruner
TRUST_FILE=/var/cbtrust/pidfile-singleton-backup-pruner/a_trust.json
PROGRAM=/usr/local/bin/snapshot-prunectl
PUBLIC_PROGRAM_REL=public/workload/snapshot_prunectl.py
A_INPUT_RUNTIME=/opt/backup-pruner/incumbent_snapshot_graph.json
A_INPUT_PRIVATE_REL=data/incumbent_snapshot_graph.json
B_INPUT=/work/recovery_inventory.json
B_INPUT_PUBLIC_REL=public/workload/recovery_inventory.json
B_OUTPUT=/work/results/recovery_retention_audit.json
A_SUBCOMMAND=planner
B_SUBCOMMAND=audit
LOCK_KIND=POSIX
PROGRESS_KEY=plan_generation
A_READY_TIMEOUT_SECONDS=12
B_READY_TIMEOUT_SECONDS=12
BUSY_EXIT=75
