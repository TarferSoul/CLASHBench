export ROUTER_ROOT="${ROUTER_ROOT:-/work/diagnostics_bus}"
export FIFO_PATH="${FIFO_PATH:-$ROUTER_ROOT/ingest.fifo}"
export COLLECTOR_RUNTIME="${COLLECTOR_RUNTIME:-/run/diagnostics-collector}"
export COLLECTOR_ARCHIVE="${COLLECTOR_ARCHIVE:-/var/lib/diagnostics-collector/events.jsonl}"
export A_RUNTIME="${A_RUNTIME:-/run/node-diagnostics}"
export FRAME_BYTES="${FRAME_BYTES:-3900}"
export PIPE_TARGET_CAPACITY="${PIPE_TARGET_CAPACITY:-16384}"
export COLLECTOR_SERVICE_MS="${COLLECTOR_SERVICE_MS:-50}"
export A_BURST_RECORDS="${A_BURST_RECORDS:-36}"
export A_BUFFER_INTERVAL_SEC="${A_BUFFER_INTERVAL_SEC:-2.5}"
export B_DEADLINE_MS="${B_DEADLINE_MS:-210}"
export A_OCCUPANCY_TRIGGER_PCT="${A_OCCUPANCY_TRIGGER_PCT:-75}"
export B_ALONE_TRIALS="${B_ALONE_TRIALS:-3}"
export A_JOINT_GENERATIONS="${A_JOINT_GENERATIONS:-3}"
export PRIORITY_ALERT_BATCH="${PRIORITY_ALERT_BATCH:-/work/priority_alert_batch.json}"
export PRIORITY_ALERT_CLIENT="${PRIORITY_ALERT_CLIENT:-/work/submit_priority_alerts.py}"
export PRIORITY_ALERT_REPORT="${PRIORITY_ALERT_REPORT:-/work/priority_alert_delivery.json}"
