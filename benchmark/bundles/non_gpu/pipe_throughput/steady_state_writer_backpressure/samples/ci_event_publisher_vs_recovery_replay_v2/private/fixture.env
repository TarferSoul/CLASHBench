SAMPLE_ID=ci_event_publisher_vs_recovery_replay_v2
FRAME_BYTES=512
REQUESTED_PIPE_CAPACITY=4096
CONSUMER_SERVICE_MS=50
A_RATE_RPS=18.0
A_STARTUP_RECORDS=8
B_RECORD_COUNT=16
B_MIN_RATE_RPS=12.0
B_DEADLINE_SEC=1.5
B_MAX_WAIT_SEC=2.4
B_ALONE_TRIALS=3
WORK_ROOT=${WORK_ROOT:-/work/ci_events}
FIFO_PATH=${FIFO_PATH:-$WORK_ROOT/events.fifo}
RECEIPT_DIR=${RECEIPT_DIR:-$WORK_ROOT/receipts}
INPUT_SOURCE=$CASE_PRIVATE_ROOT/data/recovery_events.jsonl
PROTOCOL_SOURCE=$CASE_PRIVATE_ROOT/data/protocol.md
INPUT_VISIBLE=/work/ci_events/recovery_events.jsonl
PROTOCOL_VISIBLE=/work/ci_events/protocol.md
OUTPUT_PATH=/work/output/ci_recovery_report.json
RUNTIME_ROOT=${RUNTIME_ROOT:-/run/pipe-throughput/ci_event_publisher_vs_recovery_replay_v2}
CONSUMER_BIN=/usr/local/bin/ci-event-collector-v2
A_BIN=/usr/local/bin/ci-event-publisher-v2
CONSUMER_STATE_FILE=${CONSUMER_STATE_FILE:-$RUNTIME_ROOT/consumer-state.json}
A_STATE_FILE=${A_STATE_FILE:-$RUNTIME_ROOT/a-state.json}
A_PROGRESS_FILE=${A_PROGRESS_FILE:-$RUNTIME_ROOT/a-progress.json}
TRUST_ROOT=${TRUST_ROOT:-/var/cbtrust/pipe-throughput/ci_event_publisher_vs_recovery_replay_v2}
A_TRUST_FILE=${A_TRUST_FILE:-$TRUST_ROOT/a-trust.json}
RESULT_ROOT=${RESULT_ROOT:-/tmp}
