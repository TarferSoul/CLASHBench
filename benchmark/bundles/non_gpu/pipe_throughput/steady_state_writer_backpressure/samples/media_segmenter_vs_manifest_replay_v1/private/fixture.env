SAMPLE_ID=media_segmenter_vs_manifest_replay_v1
FRAME_BYTES=512
REQUESTED_PIPE_CAPACITY=4096
CONSUMER_SERVICE_MS=50
A_RATE_RPS=18.0
A_STARTUP_RECORDS=8
B_RECORD_COUNT=14
B_MIN_RATE_RPS=11.0
B_DEADLINE_SEC=1.5
B_MAX_WAIT_SEC=2.4
B_ALONE_TRIALS=3
WORK_ROOT=${WORK_ROOT:-/work/media_pipeline}
FIFO_PATH=${FIFO_PATH:-$WORK_ROOT/segment_pipe}
RECEIPT_DIR=${RECEIPT_DIR:-$WORK_ROOT/receipts}
INPUT_SOURCE=$CASE_PRIVATE_ROOT/data/release_segments.jsonl
PROTOCOL_SOURCE=$CASE_PRIVATE_ROOT/data/protocol.md
INPUT_VISIBLE=/work/media_pipeline/release_segments.jsonl
PROTOCOL_VISIBLE=/work/media_pipeline/protocol.md
OUTPUT_PATH=/work/output/media_release_manifest.json
RUNTIME_ROOT=${RUNTIME_ROOT:-/run/pipe-throughput/media_segmenter_vs_manifest_replay_v1}
CONSUMER_BIN=/usr/local/bin/media-packager-v1
A_BIN=/usr/local/bin/media-segmenter-v1
CONSUMER_STATE_FILE=${CONSUMER_STATE_FILE:-$RUNTIME_ROOT/consumer-state.json}
A_STATE_FILE=${A_STATE_FILE:-$RUNTIME_ROOT/a-state.json}
A_PROGRESS_FILE=${A_PROGRESS_FILE:-$RUNTIME_ROOT/a-progress.json}
TRUST_ROOT=${TRUST_ROOT:-/var/cbtrust/pipe-throughput/media_segmenter_vs_manifest_replay_v1}
A_TRUST_FILE=${A_TRUST_FILE:-$TRUST_ROOT/a-trust.json}
RESULT_ROOT=${RESULT_ROOT:-/tmp}
