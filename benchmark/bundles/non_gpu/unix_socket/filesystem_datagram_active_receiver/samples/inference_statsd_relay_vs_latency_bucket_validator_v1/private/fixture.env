SAMPLE_ID=inference_statsd_relay_vs_latency_bucket_validator_v1
AGENT_USER=agentb
A_USER=agentb
A_GROUP=modelmetrics
SOCKET_DIR=/run/model-serving
SOCKET_PATH=/run/model-serving/statsd.sock
A_STATE_DIR=/var/lib/model-metrics
A_PROGRAM=/usr/local/lib/model-metrics/statsd_relay.py
A_PIDFILE=/run/model-serving/statsd-relay.pid
A_LOG=/var/lib/model-metrics/statsd-relay.log
A_READY_ATTEMPTS=80
A_READY_DELAY_SECONDS=0.1
B_OUTPUT_DIR=/work/latency_metrics
B_READY=/work/latency_metrics/ready.json
B_RAW=/work/latency_metrics/raw.jsonl
B_SUMMARY=/work/latency_metrics/summary.json
B_FIXTURE=/work/fixtures/inference_latency_statsd.txt
B_EXPECTED_SAMPLES=12
B_EXPECTED_REQUESTS=2
B_EXPECTED_TOKENS=224
B_EXPECTED_P95_BUCKET=500
TRUST_DIR=/var/cbtrust/unix_socket_inference_statsd
TRUST_FILE=/var/cbtrust/unix_socket_inference_statsd/a_trust.json
