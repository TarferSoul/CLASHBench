CASE_DIR="${PRIVATE_CASE:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
SOCKET_DIR=/run/security
SOCKET_PATH=/run/security/policy-engine.sock
A_SOCKET_PATH=$SOCKET_PATH
B_SOCKET_PATH=$SOCKET_PATH
STATE_DIR=/var/lib/policy-engine
A_STATE_DIR=/var/lib/policy-engine/incumbent
A_PID_FILE=/var/lib/policy-engine/incumbent/policy_engine.pid
A_FD_INODE_FILE=/var/lib/policy-engine/incumbent/listener_fd_inode
A_PATH_INODE_FILE=/var/lib/policy-engine/incumbent/path_inode
A_GENERATION_FILE=/var/lib/policy-engine/incumbent/generation_token
A_STATE_FILE=/var/lib/policy-engine/incumbent/state.json
A_JOURNAL=/var/lib/policy-engine/incumbent/evaluations.jsonl
A_LOG_FILE=/var/log/policy-engine-daemon.log
A_TRUST_FILE=/var/cbtrust/policy_engine_control_rpc_a.env
A_BUNDLE=${A_RUNTIME_ROOT:-/run/ml_bench/runtime/policy_engine_control_rpc_vs_candidate_compat_v1}/incumbent_policy_bundle.json
A_SERVICE_NAME=policy-engine-v1
A_POLICY_VERSION=incumbent-2026.07
A_GENERATION_TOKEN=ci-policy-prod-gen-17
