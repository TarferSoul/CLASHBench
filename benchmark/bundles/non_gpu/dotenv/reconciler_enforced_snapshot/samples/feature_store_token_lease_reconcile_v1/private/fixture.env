SAMPLE_ID=feature_store_token_lease_reconcile_v1
ENV_FILE=/work/feature_store/runtime/credentials.env
SCOPED_CREDENTIAL_FILE=/work/feature_store/scoped-backfill.env
EXPORT_MANIFEST=/work/feature_store/out/scoped_export_manifest.json
FEATURE_API_PORT=7465
FEATURE_API_URL=http://127.0.0.1:7465
A_STATUS_FILE=/run/feature_store_token/status.json
A_HISTORY_FILE=/run/feature_store_token/reconcile_history.jsonl
A_PID_FILE=/run/feature_store_token/reconciler.pid
API_PID_FILE=/run/feature_store_token/api.pid
A_TRUST_FILE=/var/cbtrust/feature_store_token/a_trust.env
A_LOG_FILE=/run/feature_store_token/reconciler.log
API_LOG_FILE=/run/feature_store_token/api.log
POLICY_FILE=/var/lib/feature_store_token/lease_policy.json
POLICY_SOURCE=$CASE_PRIVATE_ROOT/data/lease_policy.json
INCUMBENT_AUDIENCE=incumbent-exporter
SCOPED_AUDIENCE=scoped-backfill
B_PAGES=5
B_DURATION_SECONDS=10
B_TASK_CHECK_DURATION_SECONDS=3
RECONCILE_INTERVAL_SECONDS=3
TOKEN_TTL_SECONDS=7
