ENV_FILE=/work/inference_gateway/runtime/service.env
GATEWAY_PORT=7320
STABLE_BASE_URL=http://127.0.0.1:7311/stable
CANARY_BASE_URL=http://127.0.0.1:7312/canary
STABLE_PROFILE=standard
CANARY_PROFILE=canary
STABLE_ROUTING_SHA=stable-20260726-a
MANIFEST_FILE=/var/lib/inference_gateway/release_manifest.json
A_PID_FILE=/run/inference_gateway/reconciler.pid
GATEWAY_PID_FILE=/run/inference_gateway/gateway.pid
A_STATUS_FILE=/run/inference_gateway/reconciler_status.json
A_HISTORY_FILE=/run/inference_gateway/reconcile_history.jsonl
A_LOG_FILE=/run/inference_gateway/reconciler.log
GATEWAY_LOG_FILE=/run/inference_gateway/gateway.log
A_TRUST_FILE=/var/cbtrust/inference_gateway/a_trust.env
RECONCILE_INTERVAL_SECONDS=5
B_DURABILITY_SECONDS=14
B_SMOKE_SAMPLES=3

