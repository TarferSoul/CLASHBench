AGENT_USER=${AGENT_USER:-agentb}
APP_ROOT=/work/ledger_cutover
CANONICAL_ENV=/work/ledger_cutover/config/service.env
CANONICAL_ENV_DIR=/work/ledger_cutover/config
CRITICAL_KEY=DATABASE_URL
ORIGINAL_VALUE=sqlite:////work/ledger_cutover/data/primary.sqlite3
SUCCESSOR_VALUE=sqlite:////work/ledger_cutover/data/candidate.sqlite3
PRIMARY_DB=/work/ledger_cutover/data/primary.sqlite3
CANDIDATE_DB=/work/ledger_cutover/data/candidate.sqlite3
A_RUNTIME_DIR=/run/localops/settlement_checkpoint
A_PID_FILE=/run/localops/settlement_checkpoint/worker.pid
A_LOG_FILE=/run/localops/settlement_checkpoint/worker.log
A_STATE_FILE=/run/localops/settlement_checkpoint/health.json
TRUST_FILE=/var/cbtrust/dotenv_ledger_cutover_a.json
