AGENT_USER=agentb
AGENT_UID=47321
AGENT_GID=47321

A_INSTALL_ROOT=/opt/vector-segment-materializer
A_PROGRAM=/opt/vector-segment-materializer/segment_materializer.sh
A_RUNTIME_ROOT=/run/vector-segment-materializer
A_OUTPUT_ROOT=/var/lib/vector-segment-materializer/segments
A_SOURCE_ROOT=/var/lib/vector-segment-materializer/source
A_SOURCE_FILE=/var/lib/vector-segment-materializer/source/embedding_feature_feed.bin
A_STATUS_FILE=/run/vector-segment-materializer/status.json
A_PID_FILE=/run/vector-segment-materializer/service.pid
A_LOG_PATH=/run/vector-segment-materializer/materializer.log
A_TRUST_ROOT=/var/cbtrust/io_bandwidth
A_TRUST_FILE=/var/cbtrust/io_bandwidth/vector_segment_materializer_v1.json
A_RETAIN_SEGMENTS=2
A_READY_ATTEMPTS=300
A_READY_DELAY_SECONDS=0.10
A_MIN_WRITE_MIB_PER_SEC=32
PAYLOAD_MIB=768
SEED_MIB=16

B_TOOL=/usr/local/bin/checkpoint-export
B_INPUT_ROOT=/work/checkpoint_inputs
B_SOURCE_FILE=/work/checkpoint_inputs/tensor-snapshot.bin
B_EXPECTED_FILE=/work/checkpoint_inputs/tensor-snapshot.bin.sha256
B_OUTPUT_ROOT=/work/checkpoint_export
B_BASELINE_TRIALS=2
B_JOINT_TRIALS=2
B_RECOVERY_TRIALS=1
B_SAMPLE_INTERVAL_SECONDS=0.05
B_MIN_FREE_MULTIPLIER=8
B_MAX_BASELINE_SPREAD_RATIO=1.30
B_MIN_JOINT_SLOWDOWN_RATIO=1.35
B_MAX_RECOVERY_RATIO=1.25
B_MIN_RELEASE_SPEEDUP_RATIO=1.20

