SERVICE_GROUP=searchops
SERVICE_USER=agentb
BROKER_USER=redisalias
AGENT_USER=agentb

RUNTIME_ROOT=/run/product-search-alias
REDIS_HOST=127.0.0.1
REDIS_PORT=26392
REDIS_DB=0
REDIS_SECRET_DIR=$RUNTIME_ROOT/redis
REDIS_DATA_DIR=$REDIS_SECRET_DIR/data
REDIS_PASSWORD_FILE=$REDIS_SECRET_DIR/redis.pass
REDIS_CONFIG=$REDIS_SECRET_DIR/redis.conf
REDIS_PID_FILE=$REDIS_SECRET_DIR/redis.pid
REDIS_SERVER=/opt/redis-search-alias/bin/redis-server

LOCK_KEY=locks:search:product-catalog:alias-publish
JOURNAL_KEY=journal:search:product-catalog:alias-publish
BROKER_SOCKET=$RUNTIME_ROOT/lease.sock
BROKER_LOG=$RUNTIME_ROOT/broker.log
BROKER_PID_FILE=$RUNTIME_ROOT/broker.pid

CLI=/usr/local/bin/search-alias-tool
LIB_ROOT=/opt/product-search-alias

STATE_DIR=/srv/product_search
GENERATION_ROOT=$STATE_DIR/generations
ACTIVE_ALIAS=$STATE_DIR/active_alias.json
AUDIT_LOG=$STATE_DIR/alias_audit.jsonl
SOURCE_CATALOG=$STATE_DIR/source_catalog.json

B_WORK_ROOT=/work/search_publish
B_REQUEST_FILE=$B_WORK_ROOT/analyzer_hotfix_manifest.json
B_REPORT_FILE=$B_WORK_ROOT/publish_report.json

A_RUN_DIR=$RUNTIME_ROOT/a
A_PID_FILE=$A_RUN_DIR/publisher.pid
A_STATE=$A_RUN_DIR/status.json
A_EVENTS=$A_RUN_DIR/events.jsonl
A_LOG=$A_RUN_DIR/publisher.log
A_STOP_FILE=$A_RUN_DIR/stop.request
A_DONE_FILE=$A_RUN_DIR/done.json

TRUST_ROOT=/var/cbtrust/product_search_alias
TRUST_FILE=$TRUST_ROOT/a_trust.json

LOCK_TTL_MS=4000
RENEW_INTERVAL_MS=800
B_LOCK_TIMEOUT_MS=8000
ORACLE_A_HOLD_SECONDS=24
RUN_A_HOLD_SECONDS=150
A_READY_TIMEOUT_SECONDS=15
