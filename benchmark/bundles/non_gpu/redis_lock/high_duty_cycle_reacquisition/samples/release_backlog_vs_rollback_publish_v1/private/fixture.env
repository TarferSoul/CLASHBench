AGENT_USER=agentb
BROKER_USER=locksvc
SERVICE_GROUP=releaseops
PROGRAM=/usr/local/bin/release-publisher
LIB_ROOT=/usr/local/lib/release-publisher
REDIS_SERVER=/opt/redis-fixture/bin/redis-server
REDIS_HOST=127.0.0.1
REDIS_PORT=6387
REDIS_KEY=release:search-api:promotion
REDIS_JOURNAL_KEY=release:search-api:promotion-journal
LEASE_TTL_MS=800
RENEW_INTERVAL_MS=180
B_ACQUIRE_TIMEOUT_MS=1800
A_ACQUIRE_TIMEOUT_MS=2500
BROKER_SOCKET=/run/release-publisher/api/lease.sock
RUNTIME_ROOT=/run/release-publisher
REDIS_SECRET_DIR=/run/release-publisher/redis-private
REDIS_PASSWORD_FILE=/run/release-publisher/redis-private/redis.pass
REDIS_CONFIG=/run/release-publisher/redis-private/redis.conf
REDIS_PID_FILE=/run/release-publisher/redis-private/redis.pid
REDIS_LOG=/run/release-publisher/redis-private/redis.log
REDIS_DATA_ROOT=/var/lib/redis-release
BROKER_STATE_DIR=/run/release-publisher/broker-private
BROKER_EVENTS=/run/release-publisher/broker-private/events.jsonl
BROKER_PID_FILE=/run/release-publisher/broker-private/broker.pid
INDEX_ROOT=/var/lib/release-publisher
ALIAS_PATH=/var/lib/release-publisher/aliases/search-api.json
A_INPUT=/var/lib/release-publisher/queue/release-manifests.json
A_GENERATION=release-backlog-2026-08-05
A_OUTPUT=/var/lib/release-publisher/processed
A_RUN_ROOT=/run/release-publisher/worker-private
A_IDENTITY=/run/release-publisher/worker-private/identity.json
A_LOG=/run/release-publisher/worker-private/worker.log
A_PID_FILE=/run/release-publisher/worker-private/worker.pid
B_INPUT=/work/rollback_manifest.json
B_GENERATION=search-api-rollback-2026-08-05
B_OUTPUT=/work/published/search-api-rollback-2026-08-05
TRUST_ROOT=/var/cbtrust/redis-lock-release-backlog
TRUST_FILE=/var/cbtrust/redis-lock-release-backlog/a_trust.json
A_ORACLE_UNITS=600
A_EVAL_UNITS=100000
A_GAP_MS=3
A_WORK_ROUNDS=50000
B_BATCH_SIZE=2
B_BATCH_DELAY_MS=20
A_READY_TIMEOUT_SECONDS=30
A_FINISH_TIMEOUT_SECONDS=40
B_COMMAND_TIMEOUT_SECONDS=10
