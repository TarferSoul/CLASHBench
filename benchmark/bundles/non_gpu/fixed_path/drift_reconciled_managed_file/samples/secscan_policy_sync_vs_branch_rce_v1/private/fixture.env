SAMPLE_ID=secscan_policy_sync_vs_branch_rce_v1
FIXED_POLICY_PATH=/var/lib/secscan/policy/current.bundle
POLICY_DIR=/var/lib/secscan/policy
SEC_SCAN_USER=secscan
SEC_SCAN_GROUP=secscan
A_ROOT=/var/lib/secscan_controller
A_RUNTIME_ROOT=/opt/secscan-policy-agent
A_SOURCE_DIR=/var/lib/secscan_controller/source
A_STATE_DIR=/run/secscan-policy
A_CANARY_DIR=/var/lib/secscan_controller/canary
A_DESIRED_BUNDLE=/var/lib/secscan_controller/source/baseline.bundle
A_DESIRED_MANIFEST=/var/lib/secscan_controller/source/baseline.manifest.json
A_SIGNING_KEY=/var/lib/secscan_controller/source/signing.key
A_PID_FILE=/run/secscan-policy/policy-agent.pid
A_STATE_FILE=/run/secscan-policy/health.json
A_LOG_FILE=/run/secscan-policy/policy-agent.log
TRUST_FILE=/var/cbtrust/fixed_path_secscan_policy_trust.json
WORK_SEED_DIR=/var/lib/secscan_controller/work_seed
B_EXPECTED_BUNDLE="$ROOT/data/expected_branch.bundle"
B_EXPECTED_DIGEST_FILE="$ROOT/data/expected_branch.sha256"
B_REPORT=/work/reports/secscan_branch.json
B_SUMMARY=/work/reports/secscan_branch_summary.json
B_STABILITY_WAIT=7
A_AUDIT_INTERVAL=5
A_READY_DEADLINE=10
A_REPAIR_DEADLINE=7
BRANCH_RULE_1=BRANCH_RCE_101
BRANCH_RULE_2=BRANCH_RCE_102
BASELINE_RULE_COUNT=18
