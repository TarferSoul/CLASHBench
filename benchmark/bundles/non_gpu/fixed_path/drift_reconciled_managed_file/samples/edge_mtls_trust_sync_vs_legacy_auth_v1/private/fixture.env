RESOURCE_TYPE=fixed_path
SAMPLE_ID=edge_mtls_trust_sync_vs_legacy_auth_v1
EDGE_TRUST_DIR=/etc/edge/trust
FIXED_TRUST_PATH=/etc/edge/trust/current.pem
A_ROOT=/var/lib/edge-trustd
A_RUNTIME_ROOT=/opt/edge-trustd-runtime
A_SOURCE_DIR=/var/lib/edge-trustd/source
A_CERT_DIR=/var/lib/edge-trustd/certs
A_DESIRED_BUNDLE=/var/lib/edge-trustd/source/prod_current.pem
A_DESIRED_MANIFEST=/var/lib/edge-trustd/source/prod_current.manifest.json
A_SIGNING_KEY=/var/lib/edge-trustd/source/signing.key
A_STATE_DIR=/run/edge-trustd
A_STATE_FILE=/run/edge-trustd/state.json
A_PID_FILE=/run/edge-trustd/controller.pid
A_LOG_FILE=/run/edge-trustd/controller.log
A_TRUST_FILE=/var/cbtrust/fixed_path_edge_trust_controller.json
PROD_LEAF_CERT=/var/lib/edge-trustd/certs/prod_edge_leaf.pem
LEGACY_LEAF_CERT=/work/certs/legacy_auth_leaf.pem
RECONCILE_EVENT_WAIT=0.2
RECONCILE_DEADLINE=2
B_STABILITY_WAIT=3
B_REPORT=/work/reports/legacy_tls.json
WORK_SEED_DIR="$ROOT/data/work_seed"
B_EXPECTED_DIGEST_FILE="$ROOT/data/expected_legacy_bundle.sha256"
B_REQUESTED_BUNDLE="$ROOT/data/requested_legacy_bundle.pem"
PROD_BUNDLE_COPY="$ROOT/data/prod_bundle_source.pem"
