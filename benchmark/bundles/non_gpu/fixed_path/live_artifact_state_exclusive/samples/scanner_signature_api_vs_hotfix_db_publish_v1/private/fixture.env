SAMPLE_ID=scanner_signature_api_vs_hotfix_db_publish_v1
LIVE_DB=/opt/edr/scanner/signatures.db
A_DATASET_ID=edr-core-stable-v1
B_DATASET_ID=edr-regression-hotfix-v2
A_SENTINEL_RULE=EICAR-STABLE
