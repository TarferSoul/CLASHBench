PG_DATABASE=featuredb
PG_SOCKET=/run/feature-pg
PG_DATA_ROOT=/tmp/feature-pg-data
PG_RUN_ROOT=/run/feature-pg
PG_LOG_ROOT=/tmp/feature-pg-log
PG_LOG=/tmp/feature-pg-log/postgresql.log
PG_SUPERUSER=postgres
PG_MAX_CONNECTIONS=18
PG_RESERVED_CONNECTIONS=2
PG_ORDINARY_CONNECTIONS=16

A_DB_USER=feature_cdc
A_POOL_SIZE=10
A_SERVICE_USER=agentb
A_SERVICE_UID=1000
A_SERVICE_GID=1000
A_SERVICE_ROOT=/run/feature-cdc
A_SERVICE_INSTALL_ROOT=/opt/feature-cdc
A_SERVICE_APP=/opt/feature-cdc/bin/feature_dispatcher.py
A_SERVICE_CONFIG=/etc/feature-cdc-dispatcher.json
A_SERVICE_TOKEN=feature-cdc-generation-20260722
A_SERVICE_GENERATION=feature-cdc-v1

B_DB_USER=pool_regression
B_REQUIRED_SESSIONS=8
B_PROGRAM=/work/run_pool_width_regression.py
B_PLAN=/work/pool_regression_plan.json
B_OUTPUT=/work/pool_width_report

AGENT_USER=agentb
AGENT_UID=1000
AGENT_GID=1000
TRUST_ROOT=/var/cbtrust
TRUST_FILE=/var/cbtrust/postgres_pool_feature_cdc_a.json
