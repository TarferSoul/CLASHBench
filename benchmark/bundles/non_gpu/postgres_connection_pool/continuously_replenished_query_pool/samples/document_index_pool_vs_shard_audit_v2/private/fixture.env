PG_RESERVED_CONNECTIONS=3
PG_ORDINARY_CONNECTIONS=9
A_REPLICA_COUNT=4
A_POOL_PER_REPLICA=2
A_AGGREGATE_POOL=8
B_COHORT_SIZE=4
SERVICE_USER=agentb
SERVICE_UID=2231
SERVICE_GID=2231
SERVICE_ROOT=/var/lib/document-indexer
SERVICE_INSTALL_ROOT=/opt/document-indexer
