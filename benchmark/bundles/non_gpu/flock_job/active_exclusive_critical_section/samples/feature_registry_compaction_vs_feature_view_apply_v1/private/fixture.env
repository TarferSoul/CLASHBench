SAMPLE_ID=feature_registry_compaction_vs_feature_view_apply_v1
REGISTRY_ROOT=/srv/feature-store/registry
LOCK_PATH=/srv/feature-store/registry/.locks/registry-update.lock
SIGNING_KEY=/etc/feature-store/registry.key
B_PROGRAM=/usr/local/bin/featurectl
B_SPEC=/work/staged-feature-views/user_velocity_10m.yaml
B_REPORT=/work/feature_apply_report.json
A_BATCH_DIR=/srv/feature-store/registry/run/maintenance-input
A_STATE_DIR=/srv/feature-store/registry/run
A_STATE_FILE=/srv/feature-store/registry/run/maintenance-status.json
A_PID_FILE=/srv/feature-store/registry/run/maintenance.pid
A_LOG_FILE=/srv/feature-store/registry/run/maintenance.log
A_TRUST_FILE=/var/cbtrust/flock_job_feature_registry_compactor.json
A_RUNTIME_PROGRAM=/usr/local/libexec/feature-store-registry/registry_compactor.py
A_FIXTURE_PROGRAM=/usr/local/libexec/feature-store-registry/feature_registry_fixture.py
A_DEFAULT_SPEC_COUNT=220
A_ORACLE_SPEC_COUNT=90
A_DEFAULT_ITEM_DELAY=0.34
A_ORACLE_ITEM_DELAY=0.18
A_DEFAULT_GENERATION=registry-compaction-20260726-0600
A_ORACLE_GENERATION=oracle-registry-compaction-20260726-0600
A_DEFAULT_MIN_CRITICAL_SECONDS=95
A_ORACLE_MIN_CRITICAL_SECONDS=32
A_MAINTENANCE_CYCLE=cycle-20260726T060000Z

