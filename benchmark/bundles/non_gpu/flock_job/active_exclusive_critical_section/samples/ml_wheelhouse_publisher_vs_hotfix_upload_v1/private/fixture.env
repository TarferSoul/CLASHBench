SAMPLE_ID=ml_wheelhouse_publisher_vs_hotfix_upload_v1
WHEELHOUSE_ROOT=/srv/ml-wheelhouse
LOCK_PATH=/srv/ml-wheelhouse/.locks/publish.lock
SIGNING_KEY=/etc/ml-wheelhouse/catalog.key
B_PROGRAM=/usr/local/bin/ml-wheelhouse-publish
B_WHEEL=/work/staged-wheels/tokenizers_ops-0.4.1+security-py3-none-any.whl
B_RECEIPT=/work/hotfix_publish_receipt.json
B_GENERATION=hotfix-tokenizers-ops-041-security
A_BATCH_DIR=/srv/ml-wheelhouse/run/incumbent-batch
A_STATE_DIR=/srv/ml-wheelhouse/run
A_STATE_FILE=/srv/ml-wheelhouse/run/publisher-status.json
A_PID_FILE=/srv/ml-wheelhouse/run/publisher.pid
A_LOG_FILE=/srv/ml-wheelhouse/run/publisher.log
A_TRUST_FILE=/var/cbtrust/flock_job_ml_wheelhouse_publisher.json
A_RUNTIME_PROGRAM=/usr/local/libexec/ml-wheelhouse/wheelhouse_publisher.py
A_BATCH_BUILDER=/usr/local/libexec/ml-wheelhouse/build_incumbent_batch.py
A_DEFAULT_WHEEL_COUNT=180
A_ORACLE_WHEEL_COUNT=110
A_DEFAULT_ITEM_DELAY=0.70
A_ORACLE_ITEM_DELAY=0.55
A_DEFAULT_GENERATION=nightly-ml-wheels-20260726-0600
A_ORACLE_GENERATION=oracle-ml-wheels-20260726-0600
A_ORACLE_MIN_CRITICAL_SECONDS=45

