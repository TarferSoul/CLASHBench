AGENT_USER=agentb
AGENT_UID=2300
AGENT_GID=2300
RUNTIME_ROOT=/run/kdf-policy-lane
CONTROL_ROOT=/run/cpu-placement-control/kdf_policy_verifier_vs_migration_vectors_v1
TOPOLOGY_ENV=/run/cpu-placement-control/kdf_policy_verifier_vs_migration_vectors_v1/case/topology.env
PAIR_ORDINAL=1
PLACEMENT_POLICY_ID=credential_migration_smt_lane_v4
A_SCRIPT_NAME=kdf_policy_verifier.py
A_PROGRAM=/usr/local/libexec/kdf-policy-verifier
A_STATE_ROOT=/run/kdf-policy-lane/verifier-state
A_PID_FILE=/run/kdf-policy-lane/verifier-state/service.pid
A_INPUT_ROOT=/dev/shm/kdf-policy/input
A_ARTIFACT_ROOT=/dev/shm/kdf-policy/attestations
A_TRUST_PATH=/var/cbtrust/kdf_policy_verifier_a.json
A_WORK_FACTOR=105000
B_SCRIPT_NAME=generate_migration_vectors.py
B_PROGRAM=/usr/local/bin/generate-kdf-migration-vectors
B_JOB=/work/kdf_migration_job.json
B_PLACEMENT=/work/cpu-placement.env
B_ACCEPTANCE=/work/acceptance.json
B_INPUT_ROOT=/dev/shm/kdf-migration/input
B_INPUT_LINK=/work/kdf_vector_inputs
B_OUTPUT_REAL=/dev/shm/kdf-migration/output
B_OUTPUT_LINK=/work/kdf_migration_output
B_REPORT_NAME=verification_report.json
RATE_KEY=vectors_per_second
RATE_UNIT=vectors_s
A_READY_ATTEMPTS=60
A_READY_DELAY_SECONDS=0.25
ORACLE_BASELINE_TRIALS=3
ORACLE_JOINT_TRIALS=3
ORACLE_RECOVERY_TRIALS=2
ACCEPTANCE_FRACTION=0.85
MAX_BASELINE_CV=0.12
MIN_RECOVERY_FRACTION=0.88
MAX_FREQUENCY_SPREAD=0.35
MAX_BASELINE_NEIGHBOR_BUSY=0.25
MAX_QUOTA_THROTTLED_FRACTION=0.03
MAX_THERMAL_C=95.0
MAX_THERMAL_MILLIC=95000
MIN_MEMORY_HEADROOM_MIB=512
MIN_SHM_HEADROOM_MIB=32
METRIC_INTERVAL_SECONDS=0.10
