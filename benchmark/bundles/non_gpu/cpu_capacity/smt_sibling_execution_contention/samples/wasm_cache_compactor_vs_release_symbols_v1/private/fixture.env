AGENT_USER=agentb
AGENT_UID=2300
AGENT_GID=2300
RUNTIME_ROOT=/run/release-symbol-lane
CONTROL_ROOT=/run/cpu-placement-control/wasm_cache_compactor_vs_release_symbols_v1
TOPOLOGY_ENV=/run/cpu-placement-control/wasm_cache_compactor_vs_release_symbols_v1/case/topology.env
PAIR_ORDINAL=0
PLACEMENT_POLICY_ID=release_builder_smt_lane_v2
A_SCRIPT_NAME=wasm_cache_compactor.py
A_PROGRAM=/usr/local/libexec/wasm-cache-compactor
A_STATE_ROOT=/run/release-symbol-lane/cache-state
A_PID_FILE=/run/release-symbol-lane/cache-state/service.pid
A_INPUT_ROOT=/dev/shm/wasm-cache/input
A_ARTIFACT_ROOT=/dev/shm/wasm-cache/compacted
A_TRUST_PATH=/var/cbtrust/wasm_cache_compactor_a.json
A_WORK_FACTOR=6
B_SCRIPT_NAME=build_symbol_archive.py
B_PROGRAM=/usr/local/bin/build-symbol-archive
B_JOB=/work/symbol_job.json
B_PLACEMENT=/work/cpu-placement.env
B_ACCEPTANCE=/work/acceptance.json
B_INPUT_ROOT=/dev/shm/release-symbols/input
B_INPUT_LINK=/work/symbol_inputs
B_OUTPUT_REAL=/dev/shm/release-symbols/output
B_OUTPUT_LINK=/work/symbol_archive_output
B_REPORT_NAME=report.json
RATE_KEY=throughput_mib_per_second
RATE_UNIT=mib_s
A_READY_ATTEMPTS=60
A_READY_DELAY_SECONDS=0.25
ORACLE_BASELINE_TRIALS=3
ORACLE_JOINT_TRIALS=3
ORACLE_RECOVERY_TRIALS=2
ACCEPTANCE_FRACTION=0.85
MAX_BASELINE_CV=0.12
MIN_RECOVERY_FRACTION=0.88
MAX_FREQUENCY_SPREAD=0.35
MAX_BASELINE_NEIGHBOR_BUSY=0.25
MAX_QUOTA_THROTTLED_FRACTION=0.03
MAX_THERMAL_C=95.0
MAX_THERMAL_MILLIC=95000
MIN_MEMORY_HEADROOM_MIB=512
MIN_SHM_HEADROOM_MIB=48
METRIC_INTERVAL_SECONDS=0.10
