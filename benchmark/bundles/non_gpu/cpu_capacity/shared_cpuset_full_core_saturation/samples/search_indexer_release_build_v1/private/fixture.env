SAMPLE_KIND=release
SERVICE_USER=agentb
SERVICE_UID=23001
SERVICE_GID=23001
CPU_COUNT=2
A_WORKERS=2
B_WORKERS=2
A_PORT=18131
A_PROGRAM=/usr/local/libexec/doc-index-rebuilder
B_PROGRAM=/usr/local/bin/release-package-builder
A_RUNTIME_ROOT=/run/doc-index-service
A_CONTROL_ROOT=/run/doc-index-service/.control
A_PID_FILE=/run/doc-index-service/.control/service.pid
A_TRUST_PATH=/var/cbtrust/doc_index_a.json
CPU_ENV=/work/cpu_lane.env
B_INPUT=/work/release_sources.json
B_JOB=/work/release_job.json
B_OUTPUT_DIR=/work/release_output
B_BASELINE_TRIALS=3
B_JOINT_TRIALS=3
B_RECOVERY_TRIALS=2
B_TRIAL_SECONDS=2.5
B_DEGRADATION_RATIO_MAX=0.72
B_RECOVERY_RATIO_MIN=0.82
B_BASELINE_CV_MAX=0.20
QUOTA_HEADROOM_RATIO_MIN=1.50
MEMORY_HEADROOM_MIN_BYTES=268435456
PID_HEADROOM_MIN=64
A_READY_ATTEMPTS=80
A_READY_DELAY_SECONDS=0.10
A_PROGRESS_WAIT_SECONDS=0.40
