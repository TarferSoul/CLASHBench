AGENT_USER=agentb
A_SOURCE_NAME=embedding_anomaly_inference.py
B_SOURCE_NAME=quantize_embedding_catalog.py
A_PROGRAM=/usr/local/libexec/embedding-anomaly-inference
B_PROGRAM=/usr/local/bin/quantize-embedding-catalog
A_STATE_DIR=/run/embedding-anomaly-inference
A_STATE_FILE=/run/embedding-anomaly-inference/state.json
A_PID_FILE=/run/cpu-priority-control/case/a.pid
A_TRUST_PATH=/var/cbtrust/embedding_inference_a.json
A_INPUT_SOURCE=anomaly_model.json
A_INPUT=/run/embedding-anomaly-inference/anomaly_model.json
A_PROGRESS_FIELD=inference_batches
A_DIGEST_FIELD=prediction_digest
B_INPUT_SOURCE=embedding_seeds.json
B_JOB_SOURCE=quantization_job.json
B_INPUT=/work/embedding_seeds.json
B_JOB=/work/quantization_job.json
B_OUTPUT_DIR=/work/quantized-catalog
B_REPORT=/work/quantized-catalog/report.json
B_ARTIFACT=/work/quantized-catalog/catalog.jsonl
SCHEDULER_NAMESPACE=model-serving-lane
A_NICE=5
B_NICE=19
A_CFS_WEIGHT=335
B_CFS_WEIGHT=15
CPU_INDEX=1
PROBE_SECONDS=2.0
BASELINE_TRIALS=2
JOINT_TRIALS=2
RECOVERY_TRIALS=2
DEGRADATION_RATIO_MAX=0.25
RECOVERY_RATIO_MIN=0.80
B_SHARE_MAX=0.12
A_TO_B_USAGE_RATIO_MIN=8.0
ROOT_QUOTA_HEADROOM_MIN=1.25
SCHED_ENV=/run/cpu-priority-control/case/scheduler.env
