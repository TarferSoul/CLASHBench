AGENT_USER=agentb
A_SOURCE_NAME=release_attestation_worker.py
B_SOURCE_NAME=priority_provenance_index.py
A_PROGRAM=/usr/local/libexec/release-attestation-worker
B_PROGRAM=/usr/local/bin/priority-provenance-index
