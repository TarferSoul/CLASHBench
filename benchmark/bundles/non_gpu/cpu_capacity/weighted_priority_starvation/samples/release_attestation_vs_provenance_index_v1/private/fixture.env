A_STATE_FILE=/run/release-attestation-worker/state.json
A_PID_FILE=/run/cpu-priority-control/case/a.pid
A_TRUST_PATH=/var/cbtrust/release_attestation_a.json
A_INPUT_SOURCE=release_manifests.json
