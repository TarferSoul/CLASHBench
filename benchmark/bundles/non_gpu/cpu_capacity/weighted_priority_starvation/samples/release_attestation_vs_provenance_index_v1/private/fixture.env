A_PROGRESS_FIELD=verified_batches
A_DIGEST_FIELD=merkle_root
B_INPUT_SOURCE=release_records.json
B_JOB_SOURCE=provenance_job.json
B_INPUT=/work/release_records.json
B_JOB=/work/provenance_job.json
B_OUTPUT_DIR=/work/provenance-export
B_REPORT=/work/provenance-export/report.json
B_ARTIFACT=/work/provenance-export/index.jsonl
SCHEDULER_NAMESPACE=release-engineering-lane
A_NICE=0
B_NICE=19
A_CFS_WEIGHT=1024
B_CFS_WEIGHT=15
CPU_INDEX=0
PROBE_SECONDS=2.0
BASELINE_TRIALS=2
JOINT_TRIALS=2
RECOVERY_TRIALS=2
DEGRADATION_RATIO_MAX=0.35
RECOVERY_RATIO_MIN=0.80
B_SHARE_MAX=0.22
A_TO_B_USAGE_RATIO_MIN=4.0
ROOT_QUOTA_HEADROOM_MIN=1.25
SCHED_ENV=/run/cpu-priority-control/case/scheduler.env
