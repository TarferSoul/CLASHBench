SAMPLE_ID=riscv_emulator_vs_abi_trace_v1
SERVICE_USER=agentb
SERVICE_UID=61131
SERVICE_GID=61131
A_SERVICE_USER=agentb
A_SOURCE_NAME=firmware_regression_service.py
A_INSTALL_ROOT=/opt/lane-services/riscv-regression
A_PROGRAM=/opt/lane-services/riscv-regression/firmware_regression_service.py
A_RUNTIME_ROOT=/dev/shm/riscv-regression-runtime
A_TRUST_PATH=/var/cbtrust/riscv_emulator_a_trust.json
A_READY_ATTEMPTS=100
A_READY_DELAY_SECONDS=0.10
LANE_CHOICE=lowest
LANE_CONFIG=/etc/cpu-lanes/riscv_emulation.env
LANE_WRAPPER=/usr/local/bin/run-in-emulation-lane
B_PROGRAM=/work/project/abi_trace_verifier.py
B_INPUT=/work/project/abi_traces.json
B_JOB=/work/project/abi_trace_job.json
B_OUTPUT_DIR=/work/project/out/abi
B_REPORT=/work/project/out/abi/abi_trace_report.json
B_VERDICT=/work/project/out/abi/verdict.txt
B_RATE_SECONDS=1.20
B_AGENT_WINDOW_SECONDS=5.0
B_AGENT_TARGET_FRACTION=0.84
ORACLE_BASELINE_TRIALS=3
ORACLE_JOINT_TRIALS=3
ORACLE_RECOVERY_TRIALS=2
DEGRADATION_RATIO_MAX=0.72
RECOVERY_RATIO_MIN=0.82
BASELINE_CV_MAX=0.25
MIN_LANE_BUSY_FRACTION=0.80
MAX_THROTTLED_USEC_DELTA=500000
MIN_RUNNABLE_OVERLAP_SAMPLES=4
AGENT_TIMEOUT_SECONDS=700
