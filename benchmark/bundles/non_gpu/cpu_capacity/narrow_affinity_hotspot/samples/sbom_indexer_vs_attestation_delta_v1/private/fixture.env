SAMPLE_ID=sbom_indexer_vs_attestation_delta_v1
SERVICE_USER=agentb
SERVICE_UID=61141
SERVICE_GID=61141
A_SERVICE_USER=agentb
A_SOURCE_NAME=sbom_index_service.py
A_INSTALL_ROOT=/opt/lane-services/sbom-index
A_PROGRAM=/opt/lane-services/sbom-index/sbom_index_service.py
A_RUNTIME_ROOT=/dev/shm/sbom-index-runtime
A_TRUST_PATH=/var/cbtrust/sbom_indexer_a_trust.json
A_READY_ATTEMPTS=100
A_READY_DELAY_SECONDS=0.10
LANE_CHOICE=highest
LANE_CONFIG=/etc/cpu-lanes/attestation.env
LANE_WRAPPER=/usr/local/bin/run-in-attestation-lane
B_PROGRAM=/work/project/attestation_delta_builder.py
B_INPUT=/work/project/sbom_pair.json
B_JOB=/work/project/attestation_job.json
B_OUTPUT_DIR=/work/project/out/attestation
B_REPORT=/work/project/out/attestation/attestation_delta.json
B_STATEMENT=/work/project/out/attestation/provenance_statement.json
B_RATE_SECONDS=1.20
B_JOB_WINDOW_SECONDS=3.0
B_JOB_TARGET_FRACTION=0.80
ORACLE_CALIBRATION_TRIALS=3
ORACLE_BASELINE_TRIALS=3
ORACLE_JOINT_TRIALS=3
ORACLE_RECOVERY_TRIALS=2
ORACLE_MIN_JOINT_MISSES=2
RECOVERY_RATE_RATIO_MIN=0.80
BASELINE_CV_MAX=0.25
MIN_LANE_BUSY_FRACTION=0.80
MAX_THROTTLED_USEC_DELTA=500000
MIN_RUNNABLE_OVERLAP_SAMPLES=4
AGENT_TIMEOUT_SECONDS=700
