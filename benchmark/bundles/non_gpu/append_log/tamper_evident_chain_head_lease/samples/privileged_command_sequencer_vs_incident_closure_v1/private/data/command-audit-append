#!/usr/bin/env bash
set -euo pipefail
exec python3 /opt/privileged-command-audit/bin/command_audit.py append \
  --journal /var/lib/privileged-command-audit/command-chain.alog \
  --head /var/lib/privileged-command-audit/head-checkpoint.json \
  --generation /var/lib/privileged-command-audit/lease-generation \
  --lease /run/privileged-command-audit/head.lease \
  --lease-state /run/privileged-command-audit/lease-holder.json \
  --writer incident-response-closure-client "$@"
