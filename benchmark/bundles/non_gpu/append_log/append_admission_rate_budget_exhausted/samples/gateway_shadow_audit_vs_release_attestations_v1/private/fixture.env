ROOT=${CASE_PRIVATE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}
RUNTIME_DIR=/var/lib/gateway-shadow-audit
PRIVATE_STATE="$RUNTIME_DIR/control"
A_RUNTIME=/opt/gateway-shadow-monitor
FIXTURE_DIR="$PRIVATE_STATE/fixtures"
TOKEN_FILE="$PRIVATE_STATE/collector.token"
PID_DIR="$PRIVATE_STATE/pids"
LOG_DIR="$PRIVATE_STATE/logs"
COLLECTOR_LOG="$PRIVATE_STATE/release_audit.jsonl"
COLLECTOR_STATE="$PRIVATE_STATE/collector_state.json"
COLLECTOR_PID="$PID_DIR/collector.pid"
COLLECTOR_STDOUT="$LOG_DIR/collector.stdout"
COLLECTOR_STDERR="$LOG_DIR/collector.stderr"
COLLECTOR_URL=http://127.0.0.1:43871
COLLECTOR_PORT=43871
REFILL_EPS=60
BURST_TOKENS=6

A_OWNER=gateway-shadow-policy
A_CLIENT_ID=edge-gateway-policy-verifier
A_PID="$PID_DIR/publisher.pid"
A_PROGRESS="$A_RUNTIME/progress.json"
A_RECEIPTS="$A_RUNTIME/receipts.jsonl"
A_STDOUT="$LOG_DIR/publisher.stdout"
A_STDERR="$LOG_DIR/publisher.stderr"
A_ROUTES="$A_RUNTIME/routes.json"
A_TOKEN="$A_RUNTIME/collector.token"
A_ATTEMPT_EPS=240
A_READY_ADMITTED=90
A_CALIBRATION_MIN_EPS=56
A_CALIBRATION_MAX_EPS=64
A_CALIBRATION_WINDOW_SECONDS=3

B_OWNER=release-attestation-check
B_CLIENT_ID=release-provenance-validator
B_TRANSACTION=release-2026-08-04-attestations
B_FIXTURE="$FIXTURE_DIR/release_attestations.jsonl"
B_TOTAL_RECORDS=72
B_DEADLINE_SECONDS=3
B_MIN_EPS=24
B_JOINT_MAX_RATIO=0.50
B_RECOVERY_MIN_RATIO=0.80
B_SUMMARY=/work/release_check/report.json
B_RECEIPTS=/work/release_check/receipts.jsonl
AGENT_VISIBLE_PATHS="/work/tools/import_release_attestations.py /work/fixtures/release_attestations.jsonl /work/collector.token"
