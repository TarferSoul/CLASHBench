#!/usr/bin/env bash
PG_DATA_ROOT=${PG_DATA_ROOT:-/var/lib/featureops-pg/data}
PG_RUN_ROOT=${PG_RUN_ROOT:-/run/feature-pg}
PG_SOCKET=${PG_SOCKET:-/run/feature-pg}
PG_LOG_ROOT=${PG_LOG_ROOT:-/var/log/featureops-pg}
PG_LOG=${PG_LOG:-/var/log/featureops-pg/server.log}
PG_SUPERUSER=${PG_SUPERUSER:-agentb}
PG_DATABASE=${PG_DATABASE:-featureops}
PG_ROLE=${PG_ROLE:-feature_migrator}
PG_PORT=${PG_PORT:-55432}
AGENT_USER=${AGENT_USER:-agentb}
A_APP=${A_APP:-/opt/feature-release/bin/rebuild_lookup_indexes.py}
A_RUNTIME_ROOT=${A_RUNTIME_ROOT:-/run/feature-index-release}
A_STATE_FILE=${A_STATE_FILE:-$A_RUNTIME_ROOT/worker.json}
A_LOG_FILE=${A_LOG_FILE:-$A_RUNTIME_ROOT/worker.log}
A_TRUST_ROOT=${A_TRUST_ROOT:-/var/cbtrust/feature_index_release}
A_TRUST_FILE=${A_TRUST_FILE:-$A_TRUST_ROOT/trust.json}
A_PREREQUISITE=${A_PREREQUISITE:-033_online_lookup_reindex}
A_STEP_COUNT=${A_STEP_COUNT:-6}
A_RUNTIME_ROWS=${A_RUNTIME_ROWS:-650000}
A_READY_TIMEOUT_TENTHS=${A_READY_TIMEOUT_TENTHS:-600}
A_PROGRESS_WAIT_SECONDS=${A_PROGRESS_WAIT_SECONDS:-0.5}
B_COMMAND=${B_COMMAND:-/usr/local/bin/feature-schema}
B_TARGET=${B_TARGET:-034_ingest_guard}
B_REPORT=${B_REPORT:-/work/feature-ingest-schema.json}
B_CONTROL_ROWS=${B_CONTROL_ROWS:-10000}
FIXED_PATH=${FIXED_PATH:-/opt/node/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin}
