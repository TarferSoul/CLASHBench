SAMPLE_KIND=repro_release
SERVICE_USER=agentb
SERVICE_UID=2100
SERVICE_GID=2100
A_PROGRAM=/usr/local/libexec/incremental-test-watcher
B_PROGRAM=/usr/local/bin/repro-release-builder
B_SOURCE_NAME=repro_release_builder.py
A_RUNTIME_ROOT=/run/incremental-test-watcher
A_STATE_PATH=/run/incremental-test-watcher/state.json
A_PARENT_PID_PATH=/run/incremental-test-watcher/parent.pid
A_TRUST_PATH=/var/cbtrust/incremental_test_watcher.json
A_PORT=18147
A_SERVICE_NAME=incremental-test-watcher
A_SERVICE_MODE=affected-shard-tests
A_PROBE_PATH=/status/affected-tests
A_WORKERS=200
A_BURST_HOLD_SECONDS=6.0
A_QUIET_SECONDS=0.4
A_READY_ATTEMPTS=300
A_READY_DELAY_SECONDS=0.1
A_PROGRESS_WAIT_SECONDS=0.5
PID_LIMIT=250
CGROUP_NAME=sandbox-root
CGROUP_MOUNT_ROOT=/run/test-watcher-cgroup-admin
ADMISSION_SOCKET=/run/test-watcher-admission.sock
CONTROLLER_READY=/run/test-watcher-admission.ready
CGROUP_METRICS_PATH=/run/local-prefork-control-incremental_test_watcher_vs_sdk_release_v1/cgroup_metrics.json
B_WORKERS=60
B_INPUT_NAME=release_units.json
B_INPUT=/work/release_units.json
B_OUTPUT_DIR=/work/release-output
B_SUMMARY=/work/release-output/release_manifest.json
B_ARTIFACT=/work/release-output/sdk_release.tar
B_HOLD_SECONDS=1.4
