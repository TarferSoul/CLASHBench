A_PROBE_PATH=/query/catalog
A_CATALOG=/run/source-symbol-indexer/source_catalog.json
A_WORKERS=128
A_READY_ATTEMPTS=80
A_READY_DELAY_SECONDS=0.1
A_PROGRESS_WAIT_SECONDS=1.0
PID_LIMIT=168
PARENT_PIDS_MAX=168
RUNTIME_ROOT=/run/ci-shared-scope
