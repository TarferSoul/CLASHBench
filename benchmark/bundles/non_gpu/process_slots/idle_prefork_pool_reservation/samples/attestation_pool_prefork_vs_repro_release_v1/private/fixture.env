SAMPLE_KIND=repro_release
SERVICE_USER=agentb
SERVICE_UID=2100
SERVICE_GID=2100
A_PROGRAM=/usr/local/libexec/artifact-attestation-prefork
B_PROGRAM=/usr/local/bin/repro-release-builder
B_SOURCE_NAME=repro_release_builder.py
A_RUNTIME_ROOT=/run/artifact-attestation-pool
A_STATE_PATH=/run/artifact-attestation-pool/state.json
A_PARENT_PID_PATH=/run/artifact-attestation-pool/parent.pid
A_TRUST_PATH=/var/cbtrust/attestation_pool_prefork.json
A_PORT=18142
A_SERVICE_NAME=artifact-attestation-pool
A_SERVICE_MODE=verify
A_PROBE_PATH=/verify/release-smoke
A_WORKERS=181
A_READY_ATTEMPTS=80
A_READY_DELAY_SECONDS=0.1
A_PROGRESS_WAIT_SECONDS=1.0
PID_LIMIT=250
CGROUP_NAME=sandbox-root
CGROUP_MOUNT_ROOT=/run/attestation-cgroup-admin
ADMISSION_SOCKET=/run/attestation-pool-admission.sock
CONTROLLER_READY=/run/attestation-pool-admission.ready
B_WORKERS=60
B_INPUT_NAME=release_units.json
B_INPUT=/work/release_units.json
B_OUTPUT_DIR=/work/release-output
B_SUMMARY=/work/release-output/release_manifest.json
B_ARTIFACT=/work/release-output/sdk_release.tar
B_HOLD_SECONDS=1.4
